file(READ "${CMAKE_CURRENT_LIST_DIR}/../source/dependencies.lock.json" PCAD_DEPENDENCIES)
function(pcad_extract name result)
  string(JSON archive GET "${PCAD_DEPENDENCIES}" ${name} archive)
  string(JSON expected GET "${PCAD_DEPENDENCIES}" ${name} sha256)
  string(JSON root GET "${PCAD_DEPENDENCIES}" ${name} root)
  set(input "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../source/${archive}")
  file(SHA256 "${input}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Upstream archive hash mismatch: ${name}")
  endif()
  set(destination "${CMAKE_BINARY_DIR}/_deps/${name}-${actual}")
  if(NOT EXISTS "${destination}/ready")
    file(MAKE_DIRECTORY "${destination}")
    file(ARCHIVE_EXTRACT INPUT "${input}" DESTINATION "${destination}")
    file(WRITE "${destination}/ready" "${actual}")
  endif()
  set(${result} "${destination}/${root}" PARENT_SCOPE)
endfunction()
pcad_extract(sqlite PCAD_SQLITE)
pcad_extract(xz PCAD_XZ)
pcad_extract(zlib PCAD_ZLIB)
pcad_extract(olc PCAD_OLC)
pcad_extract(json PCAD_JSON)

