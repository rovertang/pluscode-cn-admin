# The pinned upstream encoder maps exactly -180 degrees to +180 when lng == 0.
# Preserve the original archive and build a narrowly corrected local copy.
file(READ "${PCAD_OLC}/cpp/openlocationcode.cc" PCAD_OLC_SOURCE)
string(FIND "${PCAD_OLC_SOURCE}" "if (lng <= 0)" PCAD_OLC_FIX_POSITION)
if(PCAD_OLC_FIX_POSITION EQUAL -1)
  message(FATAL_ERROR "Pinned OLC longitude correction no longer applies")
endif()
string(REPLACE "if (lng <= 0)" "if (lng < 0)" PCAD_OLC_SOURCE "${PCAD_OLC_SOURCE}")
# Match the reference Python's shifted-coordinate rounding at exact grid edges.
foreach(axis lat lng)
  if(axis STREQUAL "lat")
    set(coordinate latitude)
    set(bound Latitude)
    set(precision Lat)
  else()
    set(coordinate longitude)
    set(bound Longitude)
    set(precision Lng)
  endif()
  set(before "int64_t ${axis} = floor(${coordinate} * kGrid${precision}PrecisionInverse);\n  ${axis} += k${bound}MaxDegrees * kGrid${precision}PrecisionInverse;")
  string(FIND "${PCAD_OLC_SOURCE}" "${before}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Pinned OLC rounding correction no longer applies")
  endif()
  string(REPLACE "${before}" "int64_t ${axis} = pcad_olc_quantize((${coordinate} + k${bound}MaxDegrees) * kGrid${precision}PrecisionInverse);" PCAD_OLC_SOURCE "${PCAD_OLC_SOURCE}")
endforeach()
string(PREPEND PCAD_OLC_SOURCE "#include \"olc_quantize.hpp\"\n")
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/_deps/olc-corrected.cc" CONTENT "${PCAD_OLC_SOURCE}" @ONLY)
add_library(pcad_olc STATIC "${CMAKE_BINARY_DIR}/_deps/olc-corrected.cc" "${PCAD_OLC}/cpp/codearea.cc")
target_include_directories(pcad_olc PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../src")
target_include_directories(pcad_olc PUBLIC "${PCAD_OLC}/cpp")
