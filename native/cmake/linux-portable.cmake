set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(NOT PCAD_ZIG)
  message(FATAL_ERROR "Set PCAD_ZIG to the Zig executable")
endif()
set(CMAKE_C_COMPILER "${PCAD_ZIG}")
set(CMAKE_C_COMPILER_ARG1 cc)
set(CMAKE_C_COMPILER_TARGET x86_64-linux-gnu.2.28)
set(CMAKE_CXX_COMPILER "${PCAD_ZIG}")
set(CMAKE_CXX_COMPILER_ARG1 c++)
set(CMAKE_CXX_COMPILER_TARGET x86_64-linux-gnu.2.28)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES PCAD_ZIG)
